# PyBlocks repository exclusions
#
# Keep the website source, assets, documentation, and vendor/blockly tracked.

# NPM dependencies
node_modules/

# Package-manager caches
.npm/
.pnpm-store/
.yarn/

# Logs and diagnostic reports
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
report.*.json

# Test and coverage output
coverage/
.nyc_output/
*.lcov

# Generated build output and tool caches
dist/
out/
.cache/
.parcel-cache/
.vite/
*.tsbuildinfo
.eslintcache
.stylelintcache

# Local environment files
.env
.env.*
!.env.example

# Editor-specific settings
.vscode/
.idea/
*.suo
*.user

# Operating-system metadata
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Temporary and backup files
*.tmp
*.temp
*.bak
*.swp
*~
